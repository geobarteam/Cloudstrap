<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- Test-layer defaults: never packed, XML-doc rules off -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1707: the <Method>_<Scenario>_<Expected> test naming convention requires underscores -->
    <!-- CA1848: tests drive loggers under test with plain ILogger calls; LoggerMessage delegates add nothing here -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1848</NoWarn>
  </PropertyGroup>

  <!-- MTP test-runner wiring applies only to *.Tests projects — SUT apps and libraries under
       src/Test (e.g. WasmTestProject) are plain projects, not test executables -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
