<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Cloudstrap.Messaging.AzureBlob\Cloudstrap.Messaging.AzureBlob.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- The offline blob-client doubles the tests hand in and register (client construction contacts nothing) -->
    <PackageReference Include="Azure.Storage.Blobs" />
    <!-- AC-CK6: the host owns its OpenTelemetry pipeline; the tests collect Wolverine's spans from it -->
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <!-- D-3 LocalDB round trips over the SQL Server transport (Microsoft.Data.SqlClient arrives transitively);
         the EF Core provider backs the outbox interplay test -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

</Project>
