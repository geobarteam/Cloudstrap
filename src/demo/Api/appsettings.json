{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cloudstrap": {
    "Application": {
      "SystemName": "demo",
      "SubsystemName": "application",
      "SubsystemType": "api",
      "EnvironmentTier": "Local"
    },
    "Logging": {
      "LevelOverrides": {
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "OpenTelemetry": {
      "Mode": "Console"
    },
    "OpenApi": {
      "Title": "Cloudstrap Demo API"
    },
    "JwtBearer": {
      "Authority": "http://127.0.0.1:5310",
      "Audience": "demo-api",
      "// RequireAuthenticatedEndpoints": "Deliberately NOT set: this host is the live demo of #5's hardened default (true) — every endpoint demands a validated token via the fallback policy, no [Authorize] attribute anywhere; only the health probes stay anonymous."
    }
  }
}
