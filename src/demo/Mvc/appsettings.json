{
  "Cloudstrap": {
    "Application": {
      "SystemName": "demo",
      "SubsystemName": "mvcdemo",
      "SubsystemType": "Web"
    },
    "Mvc": {
      "ExceptionHandling": {
        // The E2E fixture forces ASPNETCORE_ENVIRONMENT=Development, where the unset defaults would
        // select the developer exception page and detail-bearing JSON. These are the documented
        // overrides (AC-MVC6's override clause) that pin the hardened browser error page and the
        // generic problem details — the shapes the E2E tests assert.
        "UseDeveloperExceptionPage": false,
        "IncludeDetails": false
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
