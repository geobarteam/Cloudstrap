@page "/whoami"
@attribute [Authorize]
@inject IWhoAmIViewModel ViewModel

<PageTitle>Who am I</PageTitle>

<h1>Signed in as <span data-testid="user-name">@ViewModel.UserName</span></h1>
<p>
    The Api demo host validated this user's token and answered from
    <strong data-testid="api-host">@ViewModel.WhoAmI?.Host</strong>
    for subject <strong data-testid="api-subject">@ViewModel.WhoAmI?.Subject</strong>.
</p>
<a href="/">Home</a>

@code {
    // Statically server-rendered on purpose: the request's HttpContext carries the cookie session,
    // so the user-token handler can do its work with zero extra plumbing (the shipped #10 posture).
    // The ViewModel (#11 convention registration) owns the data; its API call runs inside the #12
    // IBlazorInteractionTrace scope, exporting as a root interaction span.
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }
}
